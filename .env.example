# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/nutch_ai?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# OAuth Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# OAuth callback URLs - these must exactly match what is registered with the
# provider consent screens, including the /api/v1 prefix.
GOOGLE_CALLBACK_URL="http://localhost:3100/api/v1/auth/google/callback"
GITHUB_CALLBACK_URL="http://localhost:3100/api/v1/auth/github/callback"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# AWS S3 Configuration
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="nutch-ai-files"

# AI Model Configuration
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Encryption Key for BYOK
# 32 bytes as 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Anything else is passed through scrypt. Never reuse this value between
# environments - rotating it makes every stored BYOK key undecryptable.
ENCRYPTION_KEY="your-64-hex-character-encryption-key"

# Application Configuration
PORT="3000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000,chrome-extension://*"

# Daily prompt ceiling per user on the shared Nutch key. Prompts served with a
# user's own BYOK key are not counted. -1 disables the ceiling.
DAILY_PROMPTS_ANONYMOUS="20"
DAILY_PROMPTS_SIGNED_IN="200"

# Magic-link sign-in
MAGIC_LINK_TTL_MINUTES="15"

# Rate Limiting
RATE_LIMIT_TTL="60"
RATE_LIMIT_LIMIT="100"

# File Upload Limits
MAX_FILE_SIZE_MB="10"
MAX_FILES_ANONYMOUS="5"
MAX_CHAT_SESSIONS_ANONYMOUS="3"